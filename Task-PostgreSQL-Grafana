-- 1. Создаем таблицу для логов (пункт про большой объем данных)
CREATE TABLE activity_logs (
    id SERIAL PRIMARY KEY,
    user_id INT,
    action VARCHAR(50),
    created_at TIMESTAMP DEFAULT now()
);

-- 2. Генерируем 3.5 миллиона строк (займет 10-20 секунд)
INSERT INTO activity_logs (user_id, action, created_at)
SELECT 
    (random() * 1000)::int, 
    (ARRAY['LOGIN', 'VIEW_BOOK', 'BUY_BOOK', 'LOGOUT'])[floor(random() * 4 + 1)],
    now() - (random() * interval '365 days')
