// ============================================================
// Администрирование п.4: просмотр ограничений и индексов,
// влияние индексов на запросы (PROFILE)
// ============================================================

// Список всех ограничений целостности
SHOW CONSTRAINTS;

// Список всех индексов
SHOW INDEXES;

// Запрос, использующий индекс по Book.genre — в плане должно быть NodeIndexSeek
PROFILE
MATCH (b:Book)
WHERE b.genre = 'классика'
RETURN b.title, b.year
ORDER BY b.year
LIMIT 10;
